<mujoco model="Agilex Bunker">
  <!-- Compiler options -->
  <compiler angle="radian" meshdir="../../bunker" coordinate="local" autolimits="true"/>

  <!-- Integrator options -->
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <!-- Visual options -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker">
	</default>
  </default>
	
  
  <!-- Assets and textures definitions -->
  <asset>
  
	<!-- General scene meshes and materials -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <include file="../../bunker/bunker_assests.xml"/>

  </asset>

  <!-- Worldbody and bodies definitions -->
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <include file="../../bunker/bunker_body.xml"/>

    <body name="mid_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="mid_goal_sphere" type="sphere" size="0.1" rgba="1.0 1.0 0.0 1"/>
    </body>

    <body name="final_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.1" rgba="1.0 0.0 0.0 1"/>
    </body>

  
    <!-- Generated Obstacles (Seed: 1) -->

    <body name="obstacle_0" pos="3.830 6.627 0.268">
      <geom type="cylinder" size="0.125 0.268" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_1" pos="2.667 1.555 0.384">
      <geom type="box" size="0.184 0.295 0.384" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="2.193 6.147 0.358">
      <geom type="box" size="0.101 0.278 0.358" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="4.094 -1.773 0.253">
      <geom type="cylinder" size="0.227 0.253" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_4" pos="8.270 1.574 0.313">
      <geom type="cylinder" size="0.187 0.313" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_5" pos="3.332 6.164 0.333">
      <geom type="cylinder" size="0.476 0.333" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_6" pos="-0.230 -0.375 0.253">
      <geom type="box" size="0.284 0.216 0.253" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_7" pos="-0.769 8.911 0.268">
      <geom type="cylinder" size="0.444 0.268" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_8" pos="7.747 8.679 0.326">
      <geom type="box" size="0.300 0.487 0.326" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>
</worldbody>
  
  <include file="../../bunker/bunker_actuators.xml"/>

</mujoco>