<mujoco model="Agilex Bunker">
  <!-- Compiler options -->
  <compiler angle="radian" meshdir="../../bunker" coordinate="local" autolimits="true"/>

  <!-- Integrator options -->
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <!-- Visual options -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker">
	</default>
  </default>
	
  
  <!-- Assets and textures definitions -->
  <asset>
  
	<!-- General scene meshes and materials -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <include file="../../bunker/bunker_assests.xml"/>

  </asset>

  <!-- Worldbody and bodies definitions -->
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <include file="../../bunker/bunker_body.xml"/>

    <body name="mid_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="mid_goal_sphere" type="sphere" size="0.1" rgba="1.0 1.0 0.0 1"/>
    </body>

    <body name="final_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.1" rgba="1.0 0.0 0.0 1"/>
    </body>

  
    <!-- Generated Obstacles (Seed: 2) -->

    <body name="obstacle_0" pos="-1.901 1.333 0.371">
      <geom type="cylinder" size="0.168 0.371" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_1" pos="0.019 -0.453 0.400">
      <geom type="box" size="0.114 0.372 0.400" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="6.644 7.323 0.390">
      <geom type="box" size="0.304 0.249 0.390" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="7.814 7.452 0.386">
      <geom type="box" size="0.246 0.473 0.386" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_4" pos="7.701 3.309 0.254">
      <geom type="box" size="0.324 0.194 0.254" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_5" pos="-0.917 3.122 0.334">
      <geom type="box" size="0.244 0.305 0.334" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_6" pos="6.561 5.813 0.368">
      <geom type="box" size="0.463 0.405 0.368" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_7" pos="1.343 7.308 0.310">
      <geom type="box" size="0.278 0.482 0.310" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_8" pos="4.859 -0.001 0.327">
      <geom type="box" size="0.212 0.299 0.327" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>
</worldbody>
  
  <include file="../../bunker/bunker_actuators.xml"/>

</mujoco>