<mujoco model="Agilex Bunker">
  <!-- Compiler options -->
  <compiler angle="radian" meshdir="../../bunker" coordinate="local" autolimits="true"/>

  <!-- Integrator options -->
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <!-- Visual options -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker">
	</default>
  </default>
	
  
  <!-- Assets and textures definitions -->
  <asset>
  
	<!-- General scene meshes and materials -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <include file="../../bunker/bunker_assests.xml"/>

  </asset>

  <!-- Worldbody and bodies definitions -->
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <include file="../../bunker/bunker_body.xml"/>

    <body name="mid_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="mid_goal_sphere" type="sphere" size="0.1" rgba="1.0 1.0 0.0 1"/>
    </body>

    <body name="final_goal_marker" pos="-2 -4 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.1" rgba="1.0 0.0 0.0 1"/>
    </body>

  
    <!-- Generated Obstacles (Seed: 99) -->

    <body name="obstacle_0" pos="1.569 4.193 0.263">
      <geom type="box" size="0.192 0.153 0.263" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_1" pos="3.370 5.406 0.280">
      <geom type="box" size="0.136 0.350 0.280" rgba="0.6 0.2 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="6.511 6.460 0.379">
      <geom type="cylinder" size="0.429 0.379" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="-1.173 4.927 0.301">
      <geom type="cylinder" size="0.440 0.301" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_4" pos="2.628 1.831 0.251">
      <geom type="cylinder" size="0.208 0.251" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_5" pos="1.350 8.198 0.328">
      <geom type="cylinder" size="0.132 0.328" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_6" pos="4.266 8.721 0.282">
      <geom type="cylinder" size="0.243 0.282" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_7" pos="5.970 2.301 0.277">
      <geom type="cylinder" size="0.470 0.277" rgba="0 0.6 0.2 1" contype="1" conaffinity="1"/>
    </body>
</worldbody>
  
  <include file="../../bunker/bunker_actuators.xml"/>

</mujoco>